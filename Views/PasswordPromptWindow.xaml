<Window x:Class="TheLibrary.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha"
        Height="270" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">

    <StackPanel Margin="22">
        <TextBlock x:Name="TxtPrompt" Style="{StaticResource H2}" TextWrapping="Wrap" />

        <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
        <PasswordBox x:Name="TxtPass" />

        <TextBlock Text="Confirmar" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <PasswordBox x:Name="TxtPass2" />

        <TextBlock x:Name="TxtError" Foreground="{DynamicResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource GhostButton}" Width="100" Click="Cancel_Click" />
            <Button Content="Confirmar" Width="120" Margin="10,0,0,0" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
