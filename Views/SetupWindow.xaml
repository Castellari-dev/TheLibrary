<Window x:Class="TheLibrary.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Library — Configuração inicial"
        Height="660" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource Accent}" Padding="26,20">
            <StackPanel>
                <TextBlock Text="The Library" FontSize="23" FontWeight="Bold"
                           Foreground="{DynamicResource AccentText}" />
                <TextBlock x:Name="TxtStepTitle" Text="Passo 1 de 3 — Banco de dados"
                           Foreground="{DynamicResource AccentText}" Opacity="0.9" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22">

            <Grid>
                <StackPanel x:Name="Step1">
                    <TextBlock Text="Onde a coleção será armazenada" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                               Text="Escolha o servidor de banco de dados. As tabelas são criadas automaticamente na primeira conexão." />

                    <TextBlock Text="Servidor" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbProvider" Width="260" HorizontalAlignment="Left"
                              SelectionChanged="CmbProvider_SelectionChanged">
                        <ComboBoxItem Content="Microsoft SQL Server" />
                        <ComboBoxItem Content="PostgreSQL" />
                    </ComboBox>

                    <CheckBox x:Name="ChkRaw" Content="Informar connection string manualmente"
                              Margin="0,18,0,0" Checked="ChkRaw_Changed" Unchecked="ChkRaw_Changed" />

                    <StackPanel x:Name="PnlFields" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Host / instância" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtHost" Text="localhost" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Porta" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtPort" Text="1433" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Banco de dados" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox x:Name="TxtDatabase" Text="TheLibrary" />

                        <CheckBox x:Name="ChkIntegrated" Content="Autenticação do Windows (SQL Server)"
                                  Margin="0,14,0,0" Checked="ChkIntegrated_Changed" Unchecked="ChkIntegrated_Changed"
                                  IsChecked="True" />

                        <Grid x:Name="PnlCredentials" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Usuário do banco" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TxtDbUser" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Senha do banco" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="TxtDbPass" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkTrust" Content="Confiar no certificado do servidor"
                                  IsChecked="True" Margin="0,14,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PnlRaw" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Connection string" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TxtRaw" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="9,7" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Testar conexão" Style="{StaticResource GhostButton}"
                                Click="TestConnection_Click" Width="150" />
                        <Button Content="Criar banco se não existir" Style="{StaticResource GhostButton}"
                                Click="CreateDatabase_Click" Width="200" Margin="10,0,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14">
                        <TextBlock x:Name="TxtDbStatus" Style="{StaticResource Muted}"
                                   Text="Conexão ainda não testada." />
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Text="Usuário administrador" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                               Text="Este usuário será gravado na tabela APP_USER do banco escolhido. A senha é armazenada como hash PBKDF2-SHA256, nunca em texto puro." />

                    <TextBlock Text="Usuário" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtUser" Width="320" HorizontalAlignment="Left" />

                    <TextBlock Text="Senha" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="TxtPass" Width="320" HorizontalAlignment="Left" />

                    <TextBlock Text="Confirmar senha" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="TxtPass2" Width="320" HorizontalAlignment="Left" />

                    <TextBlock x:Name="TxtUserStatus" Style="{StaticResource Muted}" Margin="0,16,0,0"
                               Foreground="{DynamicResource Danger}" />
                </StackPanel>

                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Text="Aparência" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18"
                               Text="Você pode mudar isso depois na aba Configurações." />

                    <TextBlock Text="Tema" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbTheme" Width="260" HorizontalAlignment="Left"
                              SelectionChanged="Appearance_Changed" />

                    <TextBlock Text="Cor de destaque" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <ComboBox x:Name="CmbAccent" Width="260" HorizontalAlignment="Left"
                              SelectionChanged="Appearance_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" Fill="{Binding Preview}" />
                                    <TextBlock Text="{Binding Name}" Margin="9,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Prévia" Style="{StaticResource H2}" />
                            <TextBlock Text="Texto normal na superfície do tema selecionado." />
                            <TextBlock Text="Texto secundário / descrição." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Botão" Width="100" />
                                <Button Content="Secundário" Style="{StaticResource GhostButton}" Width="120" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="26,14">
            <Grid>
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Width="110" Click="Cancel_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack" Content="Voltar" Style="{StaticResource GhostButton}"
                            Width="110" Click="Back_Click" IsEnabled="False" />
                    <Button x:Name="BtnNext" Content="Avançar" Width="130" Margin="10,0,0,0" Click="Next_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
